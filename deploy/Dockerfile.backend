# AegisPulse AI - FastAPI backend (linux/amd64)
FROM --platform=linux/amd64 python:3.12-slim

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend

WORKDIR /app

# Install the reusable pattern package + backend deps. The backend only needs the
# Decider HTTP client side; the heavy torch/model lives in the decider container.
COPY patterns /app/patterns
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -e /app/patterns/confidence_aware_tool_router \
 && pip install --no-cache-dir "strands-agents==1.61.1" boto3 "fastapi==0.143.3" \
      "uvicorn==0.54.0" "pydantic==2.14.1" "sqlmodel==0.0.48" httpx

COPY backend /app/backend

ENV AEGIS_DECIDER_ENDPOINT=http://decider:8777 \
    AEGIS_DB_URL=sqlite:////data/aegispulse.db \
    AEGIS_ENABLE_BEDROCK=1 \
    AEGIS_BEDROCK_MODEL=amazon.nova-lite-v1:0 \
    AWS_REGION=us-east-1

VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health',timeout=4).status==200 else 1)" || exit 1

WORKDIR /app/backend
CMD ["sh","-c","python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]
